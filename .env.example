NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
DB_PATH=./data/app.db
DATA_DIR=./data
SESSION_TTL_DAYS=7
# Shared password for the public homepage. Set a strong value to enable the access gate.
SITE_ACCESS_PASSWORD=
# Optional signing secret for the persistent homepage access cookie. If empty, the password is used.
SITE_ACCESS_SECRET=
SITE_ACCESS_TTL_DAYS=30
COOKIE_SECURE=false
TRUST_PROXY=false
MAX_VIDEO_BYTES=2147483648
MAX_IMAGE_BYTES=10485760
