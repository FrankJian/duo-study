# GitHub repository: github.com/FrankJian/duo-study
# GHCR image names are normalized to lowercase.
API_IMAGE=ghcr.io/frankjian/duo-study-api:1.0.0
WEB_IMAGE=ghcr.io/frankjian/duo-study-web:1.0.0

# true when the site is served through HTTPS; false for local HTTP testing.
COOKIE_SECURE=true

SESSION_TTL_DAYS=7
# Required for the homepage access gate in production.
SITE_ACCESS_PASSWORD=replace-with-a-long-random-password
SITE_ACCESS_SECRET=replace-with-a-long-random-secret
SITE_ACCESS_TTL_DAYS=30
MAX_VIDEO_BYTES=2147483648
MAX_IMAGE_BYTES=10485760
